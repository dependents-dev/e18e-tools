---
interface Props {
  title: string;
  href: string;
  /** @default false */
  internal?: boolean;
}

const { title, href, internal } = Astro.props;

const target = internal ? undefined : "_blank";
const rel = internal ? undefined : "noopener noreferrer";
---

<a {href} {target} {rel}><div class="card-title">{title}</div></a>

<style>
a {
  display: block;
  width: 100%;
  border-radius: 0.75rem;
  border: 2px solid #a3a3a3;
  background-color: #ffffff;
  padding: 0.75rem 1.25rem;
  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
  text-decoration: none;
}

a:hover {
  border-color: #525252;
}

.card-title {
  font-weight: 500;
  font-size: 1.125rem;
  color: #171717;
}

@media (min-width: 640px) {
  .card-title {
    font-size: 1.25rem;
  }
}

@media (prefers-color-scheme: dark) {
  a {
    border-color: #525252;
    background-color: #171717;
  }

  a:hover {
    border-color: #a3a3a3;
  }

  .card-title {
    color: #f5f5f5;
  }
}
</style>
